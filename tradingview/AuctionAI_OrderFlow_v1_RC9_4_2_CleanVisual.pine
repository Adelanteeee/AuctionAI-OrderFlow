//@version=6
indicator("AuctionAI Order Flow v1 — RC9.4.2 Clean Visual", overlay=true, max_labels_count=300)

string G_DELTA="Delta / CVD", G_VOLUME="Volume / Effort", G_AUCTION="Auction", G_STRUCT="Structure / Continuation", G_DISPLAY="Clean Visual"

lowerTf=input.timeframe("1","Lower Timeframe",group=G_DELTA)
deltaBodyWeight=input.float(.65,"Body Direction Weight",minval=0,maxval=1,step=.05,group=G_DELTA)
deltaCloseWeight=input.float(.35,"Close Location Weight",minval=0,maxval=1,step=.05,group=G_DELTA)
deltaPressureCap=input.float(.90,"Intrabar Pressure Cap",minval=.50,maxval=1,step=.05,group=G_DELTA)
cvdSmoothLen=input.int(5,"CVD Smoothing",minval=1,group=G_DELTA)
absDeltaPct=input.float(20.0,"Min |Delta %|",minval=0,step=1,group=G_DELTA)

highVolMult=input.float(1.5,"High Volume Multiplier",minval=1,step=.1,group=G_VOLUME)
resultThreshold=input.float(.5,"High Result / ATR",minval=.05,step=.05,group=G_VOLUME)
paceExpand=input.float(115.0,"Pace Expanding >= %",minval=100,step=5,group=G_VOLUME)
paceContract=input.float(85.0,"Pace Contracting <= %",minval=0,maxval=100,step=5,group=G_VOLUME)

profileRows=input.int(28,"Previous Day Profile Rows",minval=8,maxval=60,group=G_AUCTION)
valueAreaPct=input.float(70.0,"Value Area %",minval=50,maxval=99,step=1,group=G_AUCTION)
acceptanceCloses=input.int(2,"Acceptance Closes",minval=2,maxval=4,group=G_AUCTION)
rejectionMinPenetrationAtr=input.float(.03,"Rejection Min Penetration / ATR",minval=0,maxval=.50,step=.01,group=G_AUCTION)

swingLeft=input.int(3,"Swing Left",minval=1,maxval=10,group=G_STRUCT)
swingRight=input.int(3,"Swing Right",minval=1,maxval=10,group=G_STRUCT)
locationAtr=input.float(.60,"Continuation Location / ATR",minval=.10,maxval=2.0,step=.05,group=G_STRUCT)
watchMinScore=input.int(60,"Watch Score >=",minval=40,maxval=100,group=G_STRUCT)
confirmMinScore=input.int(75,"Failure Score >=",minval=50,maxval=100,group=G_STRUCT)
watchBars=input.int(4,"Confirmation Window Bars",minval=1,maxval=10,group=G_STRUCT)

visualMode=input.string("Minimal","Visual Mode",options=["Minimal","Balanced","Full"],group=G_DISPLAY)
showTinyMarkers=input.bool(true,"Show Tiny Markers",group=G_DISPLAY)
useGradeIntensity=input.bool(true,"Use Grade Intensity",group=G_DISPLAY)
baselineFlowTint=input.bool(false,"Tint Normal Candles By Delta/CVD",group=G_DISPLAY)
showReferenceLines=input.bool(true,"Show Previous Day POC/VAH/VAL",group=G_DISPLAY)
showHud=input.bool(true,"Show HUD",group=G_DISPLAY)

bool confirmed=barstate.isconfirmed
bool newDay=timeframe.change("D")
float atr=ta.atr(14)

[lo,lh,ll,lc,lv]=request.security_lower_tf(syminfo.tickerid,lowerTf,[open,high,low,close,volume])
int n=array.size(lv)
float buyVol=0.0
float sellVol=0.0
float classifiedVol=0.0
float wsum=math.max(deltaBodyWeight+deltaCloseWeight,.0001)
if n>0
    for i=0 to n-1
        float o=array.get(lo,i)
        float h=array.get(lh,i)
        float l=array.get(ll,i)
        float c=array.get(lc,i)
        float v=nz(array.get(lv,i))
        float r=math.max(h-l,syminfo.mintick)
        float bodyBias=math.max(-1.0,math.min(1.0,(c-o)/r))
        float closeBias=math.max(-1.0,math.min(1.0,((c-l)/r)*2.0-1.0))
        float pressure=(bodyBias*deltaBodyWeight+closeBias*deltaCloseWeight)/wsum
        pressure:=math.max(-deltaPressureCap,math.min(deltaPressureCap,pressure))
        float buyShare=.5+.5*pressure
        buyVol+=v*buyShare
        sellVol+=v*(1.0-buyShare)
        classifiedVol+=v
float delta=classifiedVol>0?buyVol-sellVol:na
float deltaPct=classifiedVol>0?delta/classifiedVol*100.0:na
var float cvd=0.0
cvd+=nz(delta)
float cvdSmooth=ta.ema(cvd,cvdSmoothLen)
float cvdSlope=cvdSmooth-cvdSmooth[1]
string cvdBias=cvdSlope>0?"RISING":cvdSlope<0?"FALLING":"FLAT"

var float dailyVolume=0.0
var array<float> currentDayCurve=array.new_float(1440,na)
var array<float> previousDayCurve=array.new_float(1440,na)
int dayMinuteKey=hour(time,syminfo.timezone)*60+minute(time,syminfo.timezone)
if newDay
    previousDayCurve:=array.copy(currentDayCurve)
    currentDayCurve:=array.new_float(1440,na)
    dailyVolume:=volume
else
    dailyVolume+=volume
array.set(currentDayCurve,dayMinuteKey,dailyVolume)
float previousDayAtSameTime=array.get(previousDayCurve,dayMinuteKey)
float dailyVolumePace=not na(previousDayAtSameTime) and previousDayAtSameTime>0?dailyVolume/previousDayAtSameTime*100.0:na
string volumePaceState=na(dailyVolumePace)?"N/A":dailyVolumePace>=paceExpand?"EXPANDING":dailyVolumePace<=paceContract?"CONTRACTING":"NORMAL"

float volAvg=ta.sma(volume,20)
float relVol=volAvg>0?volume/volAvg:na
bool highEffort=not na(relVol) and relVol>=highVolMult
float resultAbs=math.abs(close-close[1])
bool highResult=atr>0 and resultAbs>=atr*resultThreshold
bool highEffortLowResult=highEffort and not highResult
string effortResult=highEffort and highResult?"HE/HR":highEffort?"HE/LR":highResult?"LE/HR":"LE/LR"

float barRange=math.max(high-low,syminfo.mintick)
float upperWick=(high-math.max(open,close))/barRange
float lowerWick=(math.min(open,close)-low)/barRange
float closeLoc=(close-low)/barRange
float dStrength=not na(deltaPct)?math.min(1.0,math.abs(deltaPct)/math.max(absDeltaPct,1.0)):0.0
float eStrength=not na(relVol)?math.min(1.0,relVol/math.max(highVolMult,.01)):0.0
float lowResultStrength=highResult?0.0:1.0
float buyRejectStrength=math.min(1.0,(upperWick+(1.0-closeLoc))/1.2)
float sellRejectStrength=math.min(1.0,(lowerWick+closeLoc)/1.2)
float buyingAbsScore=not na(deltaPct) and deltaPct>=absDeltaPct?dStrength*30+eStrength*25+lowResultStrength*20+buyRejectStrength*25:0.0
float sellingAbsScore=not na(deltaPct) and deltaPct<=-absDeltaPct?dStrength*30+eStrength*25+lowResultStrength*20+sellRejectStrength*25:0.0
bool buyingAbsorption=confirmed and buyingAbsScore>=75
bool sellingAbsorption=confirmed and sellingAbsScore>=75

f_profile_levels(array<float> highs,array<float> lows,array<float> vols,int rowsCount,float vaPct)=>
    float outPoc=na
    float outVah=na
    float outVal=na
    int count=array.size(vols)
    if count>0
        float pLo=array.min(lows)
        float pHi=array.max(highs)
        float fullRange=pHi-pLo
        if fullRange>syminfo.mintick
            array<float> rows=array.new_float(rowsCount,0.0)
            float rowSize=fullRange/rowsCount
            float totalV=0.0
            for i=0 to count-1
                float ih=array.get(highs,i)
                float il=array.get(lows,i)
                float iv=array.get(vols,i)
                float intrabarRange=math.max(ih-il,syminfo.mintick)
                int startRow=int(math.floor((il-pLo)/rowSize))
                int endRow=int(math.floor((ih-pLo)/rowSize))
                startRow:=math.max(0,math.min(rowsCount-1,startRow))
                endRow:=math.max(0,math.min(rowsCount-1,endRow))
                for r=startRow to endRow
                    float rowLo=pLo+r*rowSize
                    float rowHi=rowLo+rowSize
                    float overlap=math.max(0.0,math.min(ih,rowHi)-math.max(il,rowLo))
                    float allocated=overlap>0?iv*overlap/intrabarRange:0.0
                    if allocated>0
                        array.set(rows,r,array.get(rows,r)+allocated)
                        totalV+=allocated
            if totalV>0
                int pocIdx=0
                float maxV=array.get(rows,0)
                for r=1 to rowsCount-1
                    float rv=array.get(rows,r)
                    if rv>maxV
                        maxV:=rv
                        pocIdx:=r
                int vaLo=pocIdx
                int vaHi=pocIdx
                float vaV=maxV
                float targetV=totalV*vaPct/100.0
                while vaV<targetV and (vaLo>0 or vaHi<rowsCount-1)
                    float lvRow=vaLo>0?array.get(rows,vaLo-1):-1.0
                    float hvRow=vaHi<rowsCount-1?array.get(rows,vaHi+1):-1.0
                    if hvRow>=lvRow and vaHi<rowsCount-1
                        vaHi+=1
                        vaV+=hvRow
                    else if vaLo>0
                        vaLo-=1
                        vaV+=lvRow
                outPoc:=pLo+(pocIdx+.5)*rowSize
                outVal:=pLo+vaLo*rowSize
                outVah:=pLo+(vaHi+1)*rowSize
    [outPoc,outVah,outVal]

var array<float> dayHighs=array.new_float()
var array<float> dayLows=array.new_float()
var array<float> dayVols=array.new_float()
var float prevDayPoc=na
var float prevDayVah=na
var float prevDayVal=na
if newDay
    [pdPoc,pdVah,pdVal]=f_profile_levels(dayHighs,dayLows,dayVols,profileRows,valueAreaPct)
    prevDayPoc:=pdPoc
    prevDayVah:=pdVah
    prevDayVal:=pdVal
    array.clear(dayHighs)
    array.clear(dayLows)
    array.clear(dayVols)
if confirmed and n>0
    for i=0 to n-1
        float iv=nz(array.get(lv,i))
        if iv>0
            array.push(dayHighs,array.get(lh,i))
            array.push(dayLows,array.get(ll,i))
            array.push(dayVols,iv)

bool hasReference=not na(prevDayPoc) and not na(prevDayVah) and not na(prevDayVal)
float rejectionPenetration=atr*rejectionMinPenetrationAtr
var int aboveAcceptCount=0
var int belowAcceptCount=0
if newDay
    aboveAcceptCount:=0
    belowAcceptCount:=0
if confirmed and hasReference
    aboveAcceptCount:=close>prevDayVah?aboveAcceptCount+1:0
    belowAcceptCount:=close<prevDayVal?belowAcceptCount+1:0
bool acceptedAbove=hasReference and aboveAcceptCount>=acceptanceCloses
bool acceptedBelow=hasReference and belowAcceptCount>=acceptanceCloses
bool rejectedAbove=hasReference and confirmed and ((high>prevDayVah+rejectionPenetration and close<=prevDayVah) or (close[1]>prevDayVah and close<=prevDayVah))
bool rejectedBelow=hasReference and confirmed and ((low<prevDayVal-rejectionPenetration and close>=prevDayVal) or (close[1]<prevDayVal and close>=prevDayVal))

float ph=ta.pivothigh(high,swingLeft,swingRight)
float pl=ta.pivotlow(low,swingLeft,swingRight)
var float prevHigh=na
var float lastHigh=na
var float prevLow=na
var float lastLow=na
if not na(ph)
    prevHigh:=lastHigh
    lastHigh:=ph
if not na(pl)
    prevLow:=lastLow
    lastLow:=pl
bool bearishStructure=not na(prevHigh) and not na(lastHigh) and not na(prevLow) and not na(lastLow) and lastHigh<prevHigh and lastLow<prevLow
bool bullishStructure=not na(prevHigh) and not na(lastHigh) and not na(prevLow) and not na(lastLow) and lastHigh>prevHigh and lastLow>prevLow
string trendState=bearishStructure?"BEARISH":bullishStructure?"BULLISH":"NEUTRAL"
float momentumMove=close-close[1]
float momentumThreshold=atr*.10
string immediateMomentum=momentumMove>momentumThreshold?"UP":momentumMove<-momentumThreshold?"DOWN":"FLAT"
float tol=atr*locationAtr
bool nearLastHigh=not na(lastHigh) and math.abs(high-lastHigh)<=tol
bool nearLastLow=not na(lastLow) and math.abs(low-lastLow)<=tol

var bool acceptedAboveLatched=false
var bool acceptedBelowLatched=false
var bool rejectedAboveLatched=false
var bool rejectedBelowLatched=false
if newDay
    acceptedAboveLatched:=false
    acceptedBelowLatched:=false
    rejectedAboveLatched:=false
    rejectedBelowLatched:=false
if confirmed and hasReference
    if not acceptedAbove
        acceptedAboveLatched:=false
    if not acceptedBelow
        acceptedBelowLatched:=false
    if close>prevDayVah
        rejectedAboveLatched:=false
    if close<prevDayVal
        rejectedBelowLatched:=false
bool acceptedAboveEvent=confirmed and acceptedAbove and not acceptedAboveLatched
bool acceptedBelowEvent=confirmed and acceptedBelow and not acceptedBelowLatched
bool rejectedAboveEvent=confirmed and rejectedAbove and nearLastHigh and not rejectedAboveLatched
bool rejectedBelowEvent=confirmed and rejectedBelow and nearLastLow and not rejectedBelowLatched
if acceptedAboveEvent
    acceptedAboveLatched:=true
if acceptedBelowEvent
    acceptedBelowLatched:=true
if rejectedAboveEvent
    rejectedAboveLatched:=true
if rejectedBelowEvent
    rejectedBelowLatched:=true

var float prevLowPrice=na
var float prevLowDelta=na
var float prevLowCvd=na
var float prevHighPrice=na
var float prevHighDelta=na
var float prevHighCvd=na
bool newLowPivot=not na(pl)
bool newHighPivot=not na(ph)
float currLowPrice=newLowPivot?low[swingRight]:na
float currLowDelta=newLowPivot?delta[swingRight]:na
float currLowCvd=newLowPivot?cvd[swingRight]:na
float currHighPrice=newHighPivot?high[swingRight]:na
float currHighDelta=newHighPivot?delta[swingRight]:na
float currHighCvd=newHighPivot?cvd[swingRight]:na
bool strongBullDiv=newLowPivot and not na(prevLowPrice) and not na(prevLowDelta) and not na(prevLowCvd) and not na(currLowDelta) and not na(currLowCvd) and currLowPrice<prevLowPrice and currLowDelta>prevLowDelta and currLowCvd>prevLowCvd
bool strongBearDiv=newHighPivot and not na(prevHighPrice) and not na(prevHighDelta) and not na(prevHighCvd) and not na(currHighDelta) and not na(currHighCvd) and currHighPrice>prevHighPrice and currHighDelta<prevHighDelta and currHighCvd<prevHighCvd
if newLowPivot
    prevLowPrice:=currLowPrice
    prevLowDelta:=currLowDelta
    prevLowCvd:=currLowCvd
if newHighPivot
    prevHighPrice:=currHighPrice
    prevHighDelta:=currHighDelta
    prevHighCvd:=currHighCvd

bool bullishPullback=close>close[1] or high>high[1]
bool bearishPullback=close<close[1] or low<low[1]
bool bearLocation=bearishStructure and nearLastHigh
bool bullLocation=bullishStructure and nearLastLow
bool bearCvdDisagreement=bearishStructure and bullishPullback and cvdBias=="RISING" and close<=nz(lastHigh,close)
bool bullCvdDisagreement=bullishStructure and bearishPullback and cvdBias=="FALLING" and close>=nz(lastLow,close)

f_cont_score(bool trendOk,bool locationOk,bool absorption,bool helr,bool cvdDis,bool conf)=>
    float s=trendOk?25.0:0.0
    if trendOk and locationOk
        s+=20
    if trendOk and absorption
        s+=20
    if trendOk and helr
        s+=15
    if trendOk and cvdDis
        s+=10
    if trendOk and conf
        s+=10
    math.min(100,s)
f_cont_grade(float s)=>s>=90?"A+":s>=75?"A":s>=60?"B":"C"

float bearWatchScore=f_cont_score(bearishStructure,bearLocation,buyingAbsorption,highEffortLowResult,bearCvdDisagreement,false)
float bullWatchScore=f_cont_score(bullishStructure,bullLocation,sellingAbsorption,highEffortLowResult,bullCvdDisagreement,false)
bool bearWatchRaw=confirmed and bullishPullback and bearWatchScore>=watchMinScore
bool bullWatchRaw=confirmed and bearishPullback and bullWatchScore>=watchMinScore
var int bearWatchAge=1000
var int bullWatchAge=1000
var bool bearWatchLatched=false
var bool bullWatchLatched=false
if bearWatchRaw and not bearWatchLatched
    bearWatchAge:=0
    bearWatchLatched:=true
if bullWatchRaw and not bullWatchLatched
    bullWatchAge:=0
    bullWatchLatched:=true
if bearWatchLatched
    bearWatchAge+=1
if bullWatchLatched
    bullWatchAge+=1
bool bearConfirm=confirmed and bearWatchLatched and bearWatchAge<=watchBars+1 and close<low[1] and close<open
bool bullConfirm=confirmed and bullWatchLatched and bullWatchAge<=watchBars+1 and close>high[1] and close>open
float bearConfirmScore=f_cont_score(bearishStructure,bearLocation,buyingAbsorption or buyingAbsorption[1],highEffortLowResult or highEffortLowResult[1],bearCvdDisagreement or bearCvdDisagreement[1],bearConfirm)
float bullConfirmScore=f_cont_score(bullishStructure,bullLocation,sellingAbsorption or sellingAbsorption[1],highEffortLowResult or highEffortLowResult[1],bullCvdDisagreement or bullCvdDisagreement[1],bullConfirm)
bool bearFailure=bearConfirm and bearConfirmScore>=confirmMinScore
bool bullFailure=bullConfirm and bullConfirmScore>=confirmMinScore
if bearFailure or bearWatchAge>watchBars+1 or not bearishStructure
    bearWatchLatched:=false
    bearWatchAge:=1000
if bullFailure or bullWatchAge>watchBars+1 or not bullishStructure
    bullWatchLatched:=false
    bullWatchAge:=1000

string visualEvent=bearFailure?"PF_DOWN":bullFailure?"PF_UP":bearWatchRaw?"WATCH_DOWN":bullWatchRaw?"WATCH_UP":acceptedAboveEvent?"ACC_UP":acceptedBelowEvent?"ACC_DOWN":rejectedAboveEvent?"REJ_DOWN":rejectedBelowEvent?"REJ_UP":buyingAbsorption?"BUY_ABS":sellingAbsorption?"SELL_ABS":strongBearDiv?"DIV_DOWN":strongBullDiv?"DIV_UP":highEffortLowResult?"HE_LR":"NONE"

float visualScore=visualEvent=="PF_DOWN"?bearConfirmScore:visualEvent=="PF_UP"?bullConfirmScore:visualEvent=="WATCH_DOWN"?bearWatchScore:visualEvent=="WATCH_UP"?bullWatchScore:visualEvent=="ACC_UP"?(volumePaceState=="EXPANDING"?90:75):visualEvent=="ACC_DOWN"?(volumePaceState=="CONTRACTING"?80:70):visualEvent=="REJ_DOWN" or visualEvent=="REJ_UP"?65:visualEvent=="BUY_ABS"?buyingAbsScore:visualEvent=="SELL_ABS"?sellingAbsScore:visualEvent=="DIV_DOWN" or visualEvent=="DIV_UP"?70:visualEvent=="HE_LR"?60:0
string visualGrade=f_cont_grade(visualScore)
int visualTransp=not useGradeIntensity?10:visualGrade=="A+"?0:visualGrade=="A"?12:visualGrade=="B"?28:50

color eventColor=visualEvent=="PF_DOWN"?color.red:visualEvent=="PF_UP"?color.lime:visualEvent=="WATCH_DOWN"?color.orange:visualEvent=="WATCH_UP"?color.aqua:visualEvent=="ACC_UP"?color.green:visualEvent=="ACC_DOWN"?color.red:visualEvent=="REJ_DOWN"?color.maroon:visualEvent=="REJ_UP"?color.green:visualEvent=="BUY_ABS"?color.fuchsia:visualEvent=="SELL_ABS"?color.teal:visualEvent=="DIV_DOWN"?color.orange:visualEvent=="DIV_UP"?color.blue:visualEvent=="HE_LR"?color.yellow:na
color baselineColor=not baselineFlowTint?na:(deltaPct>0 and cvdBias=="RISING"?color.new(color.green,75):deltaPct<0 and cvdBias=="FALLING"?color.new(color.red,75):color.new(color.gray,82))
color finalBarColor=visualEvent!="NONE"?color.new(eventColor,visualTransp):baselineColor
barcolor(finalBarColor)

bool minimal=visualMode=="Minimal"
bool balanced=visualMode=="Balanced"
bool full=visualMode=="Full"
bool showMajorMarker=showTinyMarkers and (minimal or balanced or full)
bool showSecondaryMarker=showTinyMarkers and (balanced or full)

plotshape(showMajorMarker and bearFailure,title="PF Down",style=shape.triangledown,location=location.abovebar,size=size.tiny,color=color.red,text="PF")
plotshape(showMajorMarker and bullFailure,title="PF Up",style=shape.triangleup,location=location.belowbar,size=size.tiny,color=color.lime,text="PF")
plotshape(showMajorMarker and bearWatchRaw,title="Watch Down",style=shape.circle,location=location.abovebar,size=size.tiny,color=color.orange)
plotshape(showMajorMarker and bullWatchRaw,title="Watch Up",style=shape.circle,location=location.belowbar,size=size.tiny,color=color.aqua)
plotshape(showSecondaryMarker and acceptedAboveEvent,title="ACC Up",style=shape.triangleup,location=location.belowbar,size=size.tiny,color=color.green)
plotshape(showSecondaryMarker and acceptedBelowEvent,title="ACC Down",style=shape.triangledown,location=location.abovebar,size=size.tiny,color=color.red)
plotshape(showSecondaryMarker and rejectedAboveEvent,title="REJ Down",style=shape.triangledown,location=location.abovebar,size=size.tiny,color=color.maroon)
plotshape(showSecondaryMarker and rejectedBelowEvent,title="REJ Up",style=shape.triangleup,location=location.belowbar,size=size.tiny,color=color.green)
plotshape(showSecondaryMarker and buyingAbsorption,title="Buy Abs",style=shape.diamond,location=location.abovebar,size=size.tiny,color=color.fuchsia)
plotshape(showSecondaryMarker and sellingAbsorption,title="Sell Abs",style=shape.diamond,location=location.belowbar,size=size.tiny,color=color.teal)
plotshape(showSecondaryMarker and strongBearDiv,title="Bear Div",style=shape.xcross,location=location.abovebar,size=size.tiny,color=color.orange,offset=-swingRight)
plotshape(showSecondaryMarker and strongBullDiv,title="Bull Div",style=shape.xcross,location=location.belowbar,size=size.tiny,color=color.blue,offset=-swingRight)

string eventText=acceptedAboveEvent?"ACC↑":acceptedBelowEvent?"ACC↓":rejectedAboveEvent?"REJ↓":rejectedBelowEvent?"REJ↑":strongBearDiv?"DIV↓":strongBullDiv?"DIV↑":"NONE"
string contText=bearFailure?"PF↓ "+f_cont_grade(bearConfirmScore):bullFailure?"PF↑ "+f_cont_grade(bullConfirmScore):bearWatchRaw?"WATCH↓ "+f_cont_grade(bearWatchScore):bullWatchRaw?"WATCH↑ "+f_cont_grade(bullWatchScore):"NONE"
if full and confirmed and visualEvent!="NONE"
    string dbg="Δ "+str.tostring(deltaPct,"#.0")+"% | "+cvdBias+" | "+effortResult+" | "+visualEvent+" "+visualGrade
    label.new(bar_index,close,dbg,style=label.style_label_left,color=color.new(color.black,82),textcolor=color.white,size=size.tiny)

plot(showReferenceLines?prevDayPoc:na,"Previous Day POC",color=color.fuchsia,linewidth=2)
plot(showReferenceLines?prevDayVah:na,"Previous Day VAH",color=color.new(color.green,35),style=plot.style_linebr)
plot(showReferenceLines?prevDayVal:na,"Previous Day VAL",color=color.new(color.red,35),style=plot.style_linebr)

var table hud=table.new(position.top_right,2,15,border_width=0)
if barstate.islast and showHud
    table.clear(hud,0,0,1,14)
    table.cell(hud,0,0,"AuctionAI Order Flow")
    table.cell(hud,1,0,"RC9.4.2 Clean Visual")
    table.cell(hud,0,1,"Visual Mode")
    table.cell(hud,1,1,visualMode)
    table.cell(hud,0,2,"Candle State")
    table.cell(hud,1,2,visualEvent+" | "+visualGrade,text_color=na(eventColor)?color.gray:eventColor)
    table.cell(hud,0,3,"Structure Trend")
    table.cell(hud,1,3,trendState,text_color=bearishStructure?color.red:bullishStructure?color.green:color.gray)
    table.cell(hud,0,4,"Immediate Momentum")
    table.cell(hud,1,4,immediateMomentum)
    table.cell(hud,0,5,"Delta %")
    table.cell(hud,1,5,na(deltaPct)?"N/A":str.tostring(deltaPct,"#.1")+"%")
    table.cell(hud,0,6,"CVD Bias")
    table.cell(hud,1,6,cvdBias)
    table.cell(hud,0,7,"Volume Pace")
    table.cell(hud,1,7,volumePaceState+(na(dailyVolumePace)?"":" | "+str.tostring(dailyVolumePace,"#.0")+"%"))
    table.cell(hud,0,8,"Rel Volume")
    table.cell(hud,1,8,na(relVol)?"N/A":str.tostring(relVol,"#.00")+"x")
    table.cell(hud,0,9,"Effort / Result")
    table.cell(hud,1,9,effortResult)
    table.cell(hud,0,10,"Absorption B/S")
    table.cell(hud,1,10,str.tostring(buyingAbsScore,"#.0")+" / "+str.tostring(sellingAbsScore,"#.0"))
    table.cell(hud,0,11,"Auction Event")
    table.cell(hud,1,11,eventText)
    table.cell(hud,0,12,"Continuation")
    table.cell(hud,1,12,contText)
    table.cell(hud,0,13,"Bear / Bull Watch")
    table.cell(hud,1,13,str.tostring(bearWatchScore,"#.0")+" / "+str.tostring(bullWatchScore,"#.0"))
    table.cell(hud,0,14,"Reference")
    table.cell(hud,1,14,"Previous Day")

alertcondition(acceptedAboveEvent,"Acceptance Above VAH","AuctionAI: acceptance above previous-day VAH")
alertcondition(acceptedBelowEvent,"Acceptance Below VAL","AuctionAI: acceptance below previous-day VAL")
alertcondition(rejectedAboveEvent,"Rejection Above VAH","AuctionAI: rejection above previous-day VAH near swing high")
alertcondition(rejectedBelowEvent,"Rejection Below VAL","AuctionAI: rejection below previous-day VAL near swing low")
alertcondition(bearFailure,"Bearish Pullback Failure","AuctionAI: bearish pullback failure confirmed")
alertcondition(bullFailure,"Bullish Pullback Failure","AuctionAI: bullish pullback failure confirmed")

plot(delta,"Delta",display=display.data_window)
plot(deltaPct,"Delta %",display=display.data_window)
plot(cvd,"CVD",display=display.data_window)
plot(relVol,"Relative Volume",display=display.data_window)
plot(dailyVolumePace,"Daily Volume Pace",display=display.data_window)
plot(buyingAbsScore,"Buying Absorption Score",display=display.data_window)
plot(sellingAbsScore,"Selling Absorption Score",display=display.data_window)
plot(bearWatchScore,"Bear Continuation Score",display=display.data_window)
plot(bullWatchScore,"Bull Continuation Score",display=display.data_window)
